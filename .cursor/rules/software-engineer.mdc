### Phase 3: Implementation

#### Test-Driven Development (TDD)

**Preferred approach:**

1. **Write failing test** - Based on acceptance criteria
2. **Implement feature** - Make test pass
3. **Refactor** - Improve code quality
4. **Repeat** - For each requirement

```typescript
// Example TDD cycle

// 1. Write failing test
describe('TwoFactorAuth', () => {
  it('should generate valid TOTP secret', () => {
    const secret = generateTOTPSecret();
    expect(secret).toHaveLength(32);
    expect(secret).toMatch(/^[A-Z2-7]+$/);
  });
});

// 2. Implement feature
export function generateTOTPSecret(): string {
  // Implementation
  return base32Encode(randomBytes(20));
}

// 3. Refactor if needed
// 4. Move to next requirement
```

#### Code Quality Standards

**Always follow these principles:**

##### 1. Explicit Types (TypeScript)

```typescript
// ✅ Good - Explicit types
interface User {
  id: string;
  email: string;
  twoFactorEnabled: boolean;
}

function verifyTOTP(user: User, token: string): Promise<boolean> {
  // Implementation
}

// ❌ Bad - Implicit any
function verifyTOTP(user, token) {
  // Implementation
}
```

##### 2. Error Handling

```typescript
// ✅ Good - Specific error types
class TOTPVerificationError extends Error {
  constructor(
    message: string,
    public code: 'INVALID_TOKEN' | 'EXPIRED' | 'RATE_LIMITED'
  ) {
    super(message);
    this.name = 'TOTPVerificationError';
  }
}

async function verifyTOTP(user: User, token: string): Promise<boolean> {
  try {
    // Verify token
    return true;
  } catch (error) {
    if (error instanceof TOTPVerificationError) {
      // Handle specific error
      throw error;
    }
    // Log unexpected error
    console.error('Unexpected TOTP error:', error);
    throw new Error('TOTP verification failed');
  }
}

// ❌ Bad - Silent failure
async function verifyTOTP(user, token) {
  try {
    return true;
  } catch (error) {
    return false; // Loses error information
  }
}
```

##### 3. Single Responsibility

```typescript
// ✅ Good - Single responsibility
class TOTPService {
  generateSecret(): string { /* ... */ }
  generateQRCode(secret: string): string { /* ... */ }
  verifyToken(secret: string, token: string): boolean { /* ... */ }
}

class BackupCodeService {
  generate(): string[] { /* ... */ }
  verify(code: string): boolean { /* ... */ }
}

// ❌ Bad - Too many responsibilities
class AuthService {
  login() { /* ... */ }
  logout() { /* ... */ }
  generateTOTPSecret() { /* ... */ }
  generateBackupCodes() { /* ... */ }
  sendEmail() { /* ... */ }
  updateUserProfile() { /* ... */ }
}
```

##### 4. Meaningful Names

```typescript
// ✅ Good - Clear, descriptive names
function generateTOTPSecret(): string { /* ... */ }
function verifyTOTPToken(secret: string, token: string): boolean { /* ... */ }
const MAX_TOTP_ATTEMPTS = 3;
const TOTP_WINDOW_SECONDS = 30;

// ❌ Bad - Unclear names
function gen(): string { /* ... */ }
function verify(s: string, t: string): boolean { /* ... */ }
const MAX = 3;
const TIME = 30;
```

##### 5. Documentation

```typescript
/**
 * Generates a new TOTP secret for two-factor authentication
 * 
 * @returns A base32-encoded secret string (32 characters)
 * @throws {Error} If random number generation fails
 * 
 * @example
 * ```typescript
 * const secret = generateTOTPSecret();
 * // => "JBSWY3DPEHPK3PXP"
 * ```
 */
export function generateTOTPSecret(): string {
  try {
    const buffer = randomBytes(20);
    return base32Encode(buffer);
  } catch (error) {
    throw new Error('Failed to generate TOTP secret');
  }
}
```

