## Quality Standards

### Code Review Self-Check

Before requesting review, verify:

#### Readability

```typescript
// ✅ Good - Clear and readable
async function enableTwoFactorAuth(userId: string): Promise<TOTPSetup> {
  const user = await userRepo.findById(userId);
  
  if (!user) {
    throw new UserNotFoundError(userId);
  }
  
  if (user.twoFactorEnabled) {
    throw new TOTPAlreadyEnabledError(userId);
  }
  
  const secret = totpService.generateSecret();
  const qrCode = totpService.generateQRCode(user.email, secret);
  
  await userRepo.update(userId, {
    twoFactorSecret: secret,
    twoFactorEnabled: true,
  });
  
  return { secret, qrCode };
}

// ❌ Bad - Hard to read
async function enable2FA(id: string) {
  const u = await repo.find(id);
  if (!u) throw new Error('not found');
  if (u.tfa) throw new Error('already enabled');
  const s = svc.gen();
  const qr = svc.genQR(u.email, s);
  await repo.upd(id, { twoFactorSecret: s, twoFactorEnabled: true });
  return { secret: s, qrCode: qr };
}
```

#### Maintainability

```typescript
// ✅ Good - Easy to maintain
const TOTP_CONFIG = {
  WINDOW_SECONDS: 30,
  DIGITS: 6,
  ALGORITHM: 'sha1',
  MAX_ATTEMPTS: 3,
  RATE_LIMIT_WINDOW_MS: 15 * 60 * 1000, // 15 minutes
} as const;

function verifyTOTPToken(secret: string, token: string): boolean {
  return totpService.verify(secret, token, {
    window: TOTP_CONFIG.WINDOW_SECONDS,
    digits: TOTP_CONFIG.DIGITS,
    algorithm: TOTP_CONFIG.ALGORITHM,
  });
}

// ❌ Bad - Magic numbers everywhere
function verifyTOTPToken(secret: string, token: string): boolean {
  return totpService.verify(secret, token, {
    window: 30,
    digits: 6,
    algorithm: 'sha1',
  });
}
```

#### Performance

```typescript
// ✅ Good - Efficient
async function verifyBackupCode(userId: string, code: string): Promise<boolean> {
  // Get only necessary data
  const user = await userRepo.findById(userId, { select: ['id', 'backupCodes'] });
  
  // Early return
  if (!user?.backupCodes?.length) {
    return false;
  }
  
  // Efficient comparison
  const hashedCode = hashBackupCode(code);
  const isValid = user.backupCodes.includes(hashedCode);
  
  if (isValid) {
    // Remove used code
    await userRepo.removeBackupCode(userId, hashedCode);
  }
  
  return isValid;
}

// ❌ Bad - Inefficient
async function verifyBackupCode(userId: string, code: string): Promise<boolean> {
  // Fetches entire user object
  const user = await userRepo.findById(userId);
  
  // Checks all codes every time
  for (let i = 0; i < user.backupCodes.length; i++) {
    if (bcrypt.compareSync(code, user.backupCodes[i])) {
      // Fetches user again
      const updatedUser = await userRepo.findById(userId);
      updatedUser.backupCodes.splice(i, 1);
      await userRepo.save(updatedUser);
      return true;
    }
  }
  
  return false;
}
```

## Anti-Patterns to Avoid

### 1. Skipping Tests

```
❌ "I'll add tests later"
✅ Write tests as you implement
```

### 2. Ignoring Standards

```
❌ "This is faster but doesn't follow standards"
✅ Follow repository standards always
```

### 3. Assuming Requirements

```
❌ Implementing features not in acceptance criteria
✅ Ask for clarification if unclear
```

### 4. Silent Failures

```
❌ Catching errors and returning default values
✅ Log errors and throw appropriate exceptions
```

### 5. Premature Optimization

```
❌ Optimizing before measuring performance issues
✅ Make it work, make it right, then make it fast
```

