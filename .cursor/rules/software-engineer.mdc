### Phase 4: Testing

#### Test Coverage Requirements

**Every feature must have:**

1. **Unit Tests** - Individual functions/methods
2. **Integration Tests** - Component interactions
3. **E2E Tests** - Full user workflows

#### Unit Tests

Test individual functions in isolation:

```typescript
// src/lib/totp.test.ts
import { describe, it, expect, vi } from 'vitest';
import { generateTOTPSecret, verifyTOTPToken, generateBackupCodes } from './totp';

describe('generateTOTPSecret', () => {
  it('should return 32-character base32 string', () => {
    const secret = generateTOTPSecret();
    expect(secret).toHaveLength(32);
    expect(secret).toMatch(/^[A-Z2-7]+$/);
  });

  it('should generate unique secrets', () => {
    const secret1 = generateTOTPSecret();
    const secret2 = generateTOTPSecret();
    expect(secret1).not.toBe(secret2);
  });
});

describe('verifyTOTPToken', () => {
  it('should verify valid token', () => {
    const secret = 'JBSWY3DPEHPK3PXP';
    const token = generateValidToken(secret); // Test helper
    expect(verifyTOTPToken(secret, token)).toBe(true);
  });

  it('should reject invalid token', () => {
    const secret = 'JBSWY3DPEHPK3PXP';
    expect(verifyTOTPToken(secret, '000000')).toBe(false);
  });

  it('should accept token within time window', () => {
    const secret = 'JBSWY3DPEHPK3PXP';
    const token = generateTokenAt(secret, Date.now() - 25000); // 25s ago
    expect(verifyTOTPToken(secret, token)).toBe(true);
  });

  it('should reject expired token', () => {
    const secret = 'JBSWY3DPEHPK3PXP';
    const token = generateTokenAt(secret, Date.now() - 90000); // 90s ago
    expect(verifyTOTPToken(secret, token)).toBe(false);
  });
});

describe('generateBackupCodes', () => {
  it('should generate 10 codes', () => {
    const codes = generateBackupCodes();
    expect(codes).toHaveLength(10);
  });

  it('should generate unique codes', () => {
    const codes = generateBackupCodes();
    const uniqueCodes = new Set(codes);
    expect(uniqueCodes.size).toBe(10);
  });

  it('should generate 8-character alphanumeric codes', () => {
    const codes = generateBackupCodes();
    codes.forEach(code => {
      expect(code).toHaveLength(8);
      expect(code).toMatch(/^[A-Z0-9]+$/);
    });
  });
});
```

#### Integration Tests

Test component interactions:

```typescript
// src/lib/auth.test.ts
import { describe, it, expect, beforeEach } from 'vitest';
import { AuthService } from './auth-service';
import { TOTPService } from './totp-service';
import { UserRepository } from './user-repository';

describe('AuthService Integration', () => {
  let authService: AuthService;
  let totpService: TOTPService;
  let userRepo: UserRepository;

  beforeEach(() => {
    userRepo = new UserRepository(testDatabase);
    totpService = new TOTPService();
    authService = new AuthService(userRepo, totpService);
  });

  it('should enable 2FA for user', async () => {
    const user = await userRepo.create({ email: 'test@example.com' });
    const secret = await authService.enableTwoFactor(user.id);
    
    expect(secret).toBeDefined();
    
    const updatedUser = await userRepo.findById(user.id);
    expect(updatedUser.twoFactorEnabled).toBe(true);
    expect(updatedUser.twoFactorSecret).toBe(secret);
  });

  it('should verify login with 2FA', async () => {
    const user = await userRepo.create({ 
      email: 'test@example.com',
      twoFactorEnabled: true,
      twoFactorSecret: 'JBSWY3DPEHPK3PXP'
    });

    const token = totpService.generateToken('JBSWY3DPEHPK3PXP');
    const result = await authService.login('test@example.com', 'password', token);
    
    expect(result.success).toBe(true);
    expect(result.user.id).toBe(user.id);
  });

  it('should reject login with invalid 2FA token', async () => {
    const user = await userRepo.create({ 
      email: 'test@example.com',
      twoFactorEnabled: true,
      twoFactorSecret: 'JBSWY3DPEHPK3PXP'
    });

    const result = await authService.login('test@example.com', 'password', '000000');
    
    expect(result.success).toBe(false);
    expect(result.error).toBe('INVALID_2FA_TOKEN');
  });
});
```

#### E2E Tests

Test full user workflows (Playwright example):

```typescript
// tests/e2e/two-factor-auth.spec.ts
import { test, expect } from '@playwright/test';

test.describe('Two-Factor Authentication', () => {
  test('user can enable 2FA', async ({ page }) => {
    // Login
    await page.goto('/login');
    await page.fill('[name="email"]', 'test@example.com');
    await page.fill('[name="password"]', 'password123');
    await page.click('button[type="submit"]');

    // Navigate to settings
    await page.goto('/settings/security');

    // Enable 2FA
    await page.click('button:text("Enable Two-Factor Auth")');

    // Verify QR code is displayed
    const qrCode = page.locator('[data-testid="totp-qr-code"]');
    await expect(qrCode).toBeVisible();

    // Verify setup instructions
    await expect(page.locator('text=Scan this QR code')).toBeVisible();

    // Enter TOTP code (mock or from test authenticator)
    const testToken = '123456'; // Use test TOTP generator
    await page.fill('[name="totpToken"]', testToken);
    await page.click('button:text("Verify and Enable")');

    // Verify success message
    await expect(page.locator('text=Two-factor authentication enabled')).toBeVisible();

    // Verify backup codes are displayed
    const backupCodes = page.locator('[data-testid="backup-codes"]');
    await expect(backupCodes).toBeVisible();
  });

  test('user must enter 2FA code on login', async ({ page, context }) => {
    // Setup: User already has 2FA enabled
    await page.goto('/login');
    await page.fill('[name="email"]', 'user-with-2fa@example.com');
    await page.fill('[name="password"]', 'password123');
    await page.click('button[type="submit"]');

    // Verify 2FA prompt appears
    await expect(page.locator('text=Enter your 6-digit code')).toBeVisible();

    // Enter invalid code
    await page.fill('[name="totpToken"]', '000000');
    await page.click('button:text("Verify")');

    // Verify error message
    await expect(page.locator('text=Invalid code')).toBeVisible();

    // Enter valid code
    const validToken = '123456'; // From test TOTP generator
    await page.fill('[name="totpToken"]', validToken);
    await page.click('button:text("Verify")');

    // Verify successful login
    await expect(page).toHaveURL('/dashboard');
  });

  test('user can login with backup code', async ({ page }) => {
    await page.goto('/login');
    await page.fill('[name="email"]', 'user-with-2fa@example.com');
    await page.fill('[name="password"]', 'password123');
    await page.click('button[type="submit"]');

    // Click "Use backup code" link
    await page.click('text=Use a backup code');

    // Enter backup code
    await page.fill('[name="backupCode"]', 'ABC12345');
    await page.click('button:text("Verify")');

    // Verify successful login
    await expect(page).toHaveURL('/dashboard');

    // Verify warning about used backup code
    await expect(page.locator('text=backup code has been used')).toBeVisible();
  });
});
```

#### Test Quality Checklist

- [ ] All acceptance criteria have corresponding tests
- [ ] Edge cases are tested (null, undefined, empty, invalid)
